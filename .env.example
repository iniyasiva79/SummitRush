# Optional for local `next dev`: rooms are stored in .data/rooms.json
# Required for production / Vercel so rooms sync across browsers and devices.
# Create an Upstash Redis database, then paste both values into the Vercel
# project settings for summitrush (Production, Preview, and Development).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
